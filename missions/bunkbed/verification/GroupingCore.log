        (hac : P .ac_b = Pac_b (gadgetE 1204) (gadgetW 1204 (1 / 2)) 0 1 (Fin.last 1204))
        (hbc : P .a_bc = Pa_bc (gadgetE 1204) (gadgetW 1204 (1 / 2)) 0 1 (Fin.last 1204))
        (hsep : P .a_b_c = Pa_b_c (gadgetE 1204) (gadgetW 1204 (1 / 2)) 0 1 (Fin.last 1204)) (F : (Fin 6 → WZ) → ℚ) :
        (∑ S ∈ Fintype.piFinset (fun i : Fin 6 => ((gadgetE 1204).image (Sym2.map (emb i))).powerset),
