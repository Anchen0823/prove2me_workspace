theorem rosser_middle_to_100000 (n : ℕ) (hn : 1000 < n) (hN : n ≤ 100000) :
    Chebyshev.psi (n:ℝ) < 1.03883*(n:ℝ) := by
  by_cases h10150 : n ≤ 10150
  · by_cases h3202 : n ≤ 3202
    · by_cases h1786 : n ≤ 1786
      · by_cases h1296 : n ≤ 1296
        · by_cases h1102 : n ≤ 1102
          · by_cases h1038 : n ≤ 1038
            · exact rosser_interval_of_power 1001 1038 1499
                (by rw [lcm_1038]; decide) (by norm_num) n
                (by exact_mod_cast (show 1001 ≤ n by omega))
                (by exact_mod_cast (show n ≤ 1038 by omega))
            · by_cases h1068 : n ≤ 1068
              · exact rosser_interval_of_power 1039 1068 1550
                  (by rw [lcm_1068]; decide) (by norm_num) n
                  (by exact_mod_cast (show 1039 ≤ n by omega))
                  (by exact_mod_cast (show n ≤ 1068 by omega))
              · exact rosser_interval_of_power 1069 1102 1600
                  (by rw [lcm_1102]; decide) (by norm_num) n
                  (by exact_mod_cast (show 1069 ≤ n by omega))
                  (by exact_mod_cast (show n ≤ 1102 by omega))
          · by_cases h1200 : n ≤ 1200
            · by_cases h1150 : n ≤ 1150
              · exact rosser_interval_of_power 1103 1150 1651
                  (by rw [lcm_1150]; decide) (by norm_num) n
                  (by exact_mod_cast (show 1103 ≤ n by omega))
                  (by exact_mod_cast (show n ≤ 1150 by omega))
              · exact rosser_interval_of_power 1151 1200 1722
                  (by rw [lcm_1200]; decide) (by norm_num) n
                  (by exact_mod_cast (show 1151 ≤ n by omega))
                  (by exact_mod_cast (show n ≤ 1200 by omega))
            · by_cases h1248 : n ≤ 1248
              · exact rosser_interval_of_power 1201 1248 1794
